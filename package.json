{
  "name": "riga-now",
  "version": "0.1.0",
  "private": true,
  "description": "Riga Now: a live city board (transit, weather, electricity price). A Repo demo.",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "pnpm run typecheck:src && vite build && tsc -p tsconfig.server.json",
    "typecheck": "pnpm run typecheck:src && tsc --noEmit -p tsconfig.test.json",
    "typecheck:src": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "node dist/node/server/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
